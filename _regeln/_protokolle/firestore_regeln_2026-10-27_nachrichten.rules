rules_version = '2';
// BäckereiOS — Firestore-Regeln, Stand 27.10.2026 (Nachrichtenzentrale Stufe 1b; Rückweg: firestore_regeln_2026-10-24_maschinen_b.rules). Begründungen: REGELN_KOMPENDIUM.md (RK §n).
service cloud.firestore {
  match /databases/{database}/documents {
    function d() { return request.resource.data; }
    function istAdmin() {
      return request.auth != null && request.auth.uid == 'ggOutbXla7dhwZbpZn7wK7Oe43j2';
    }

    // WARNUNG: ändert sich die Endung der Kennungen (KENNUNG_ENDUNG in
    // index.html), muss sie HIER mitgeändert werden.
    function hatKennung() {
      return request.auth != null
        && request.auth.token.email != null
        && request.auth.token.email.matches('^[^@]+@baeckereios[.]intern$');
    }

    function kennung() {
      return request.auth.token.email.split('@')[0];
    }

    // WARNUNG: get() STATT exists() — beides zusammen sprengt beim Ändern einer
    // Einreichung die Grenze von 10 Zugriffen je Anfrage (RK §2).
    function hatKonto() {
      return hatKennung()
        && get(/databases/$(database)/documents/bos_accounts/$(kennung())).data
             .get('freigeschaltet', false) == true;
    }

    function rolle() {
      return get(/databases/$(database)/documents/bos_accounts/$(kennung())).data.role;
    }

    function istPlanung() {
      return hatKonto() && rolle() in ['admin', 'produktionsleitung'];
    }

    function hatAdminRolle() {
      return hatKonto() && rolle() == 'admin';
    }

    function gehoertMir(personId) {
      return hatKonto()
        && exists(/databases/$(database)/documents/personen/$(personId))
        && get(/databases/$(database)/documents/personen/$(personId)).data.bosKontoId
           == kennung();
    }

    function istEinreichung(typ) {
      return typ in ['schichtplaner_wunschtag', 'urlaub_anfrage', 'sonntag_ablehnung'];
    }

    function beschreibungGueltig(b) {
      return b is string && b.size() >= 1 && b.size() <= 30;
    }
    function rufnameGueltig(r) {
      return r is string && r.size() <= 20;
    }
    function istKontenzaehler(docId) {
      return docId.matches('^konten_nummern_[a-z0-9]+$');
    }
    function nurNamensfelder(d) {
      return d.keys().hasOnly(['beschreibung', 'rufname'])
        && d.keys().hasAll(['beschreibung', 'rufname']);
    }

    match /bos_accounts/{accountId} {
      allow get: if istAdmin() || (hatKennung() && accountId == kennung());
      allow list: if istAdmin();
      allow create: if istAdmin();
      allow update: if istAdmin();
      allow delete: if istAdmin();
    }

    match /bos_events/{eventId} {
      allow read: if hatKonto() && (
        !istEinreichung(resource.data.type)
        || resource.data.bosKontoId == kennung()
        || istPlanung()
      );
      allow create: if hatKonto() && (
        !istEinreichung(d().type)
        || d().bosKontoId == kennung()
        || istPlanung()
      ) && (d().type != 'verbrauch_offiziell' || istPlanung());

      allow update: if hatKonto()
        && (!istEinreichung(resource.data.type)
            || resource.data.bosKontoId == kennung()
            || istPlanung())
        && (!istEinreichung(d().type)
            || d().bosKontoId == kennung()
            || istPlanung())
        && (resource.data.type != 'verbrauch_manuell' || istAdmin())
        && (resource.data.type != 'verbrauch_offiziell' || istPlanung())
        && (d().type != 'verbrauch_offiziell' || istPlanung());   // RK §4, 19.10.2026: Zieldokument (keine Umwidmung)
      allow delete: if hatKonto()
        && (!istEinreichung(resource.data.type)
            || resource.data.bosKontoId == kennung()
            || istPlanung())
        && (resource.data.type != 'verbrauch_manuell' || istAdmin())
        && (resource.data.type != 'verbrauch_offiziell' || istPlanung());
    }

    match /plaene/{docId} {
      allow read, write: if istPlanung();
    }
    match /positionen/{docId} {
      allow read, write: if istPlanung();
    }
    match /abwesenheiten/{docId} {
      allow read, write: if istPlanung();
    }
    match /einstellungen/{docId} {
      allow read: if istPlanung();
      // WARNUNG: Dokumentprüfungen VOR istPlanung() — kosten 0 Zugriffe.
      allow write: if docId != 'personen_nummern' && !istKontenzaehler(docId) && istPlanung();
    }
    match /einstellungen/personen_nummern {
      allow read: if istAdmin();
      allow create: if istAdmin()
        && d().keys().hasOnly(['hoechste'])
        && d().hoechste is int;
      allow update: if istAdmin()
        && d().keys().hasOnly(['hoechste'])
        && d().hoechste is int
        && d().hoechste > resource.data.hoechste;
    }

    match /einstellungen/{docId} {
      allow read: if istAdmin() && istKontenzaehler(docId);
      allow create: if istAdmin() && istKontenzaehler(docId)
        && d().keys().hasOnly(['hoechste'])
        && d().hoechste is int
        && d().hoechste >= 0;
      allow update: if istAdmin() && istKontenzaehler(docId)
        && d().keys().hasOnly(['hoechste'])
        && d().hoechste is int
        && d().hoechste > resource.data.hoechste;
    }
    match /fruehschicht_einsaetze/{docId} {
      allow read, write: if istPlanung();
    }

    match /sonntagsplan/{docId} {
      allow read:  if istPlanung() || hatKonto();
      allow write: if istPlanung();
    }

    match /personen/{personId} {
      allow read: if istAdmin() || istPlanung()
        || (hatKonto() && resource.data.bosKontoId == kennung());
      allow create, delete: if istAdmin();
      allow update: if istAdmin()
        || (istPlanung()
            && d().get('bosKontoId', null)
               == resource.data.get('bosKontoId', null));
    }
    match /konten/{personId} {
      allow read: if istPlanung() || gehoertMir(personId);
      allow write: if istPlanung();
    }

    match /namen/{personId} {
      allow read: if istAdmin() || hatKonto();

      allow create: if istAdmin()
        && nurNamensfelder(d())
        && beschreibungGueltig(d().beschreibung)
        && d().rufname == '';

      allow update: if
        (istAdmin()
          && nurNamensfelder(d())
          && beschreibungGueltig(d().beschreibung)
          && (!d().diff(resource.data).affectedKeys().hasAny(['rufname'])
              || d().rufname == ''))
        ||
        (hatKonto()
          && d().diff(resource.data).affectedKeys().hasOnly(['rufname'])
          && rufnameGueltig(d().rufname)
          && get(/databases/$(database)/documents/personen/$(personId)).data.get('bosKontoId', null)
             == kennung());

      allow delete: if istAdmin();
    }

    match /bos_zeitkontext/{datum} {
      allow read: if hatKonto();
      allow write: if istPlanung();
    }

    match /bos_profil_einstellungen/{profilId} {
      allow read, write: if hatKonto() && profilId == 'konto_' + kennung();
    }

    // WARNUNG: istAdmin() steht VOR hatKonto() — der Generalschlüssel braucht
    // dann keinen Dokumentzugriff (RK §10 A4).
    function produkteStand() { return /databases/$(database)/documents/produkte_stand/aktuell; }
    function standSteigt() {
      return (!exists(produkteStand()) && existsAfter(produkteStand()))
          || (exists(produkteStand())
              && getAfter(produkteStand()).data.nummer > get(produkteStand()).data.nummer);
    }
    // WARNUNG: ein neues Feld im Glossar (produkt_config_felder.json) braucht einen
    // Eintrag in produktFelder(), sonst lehnt die Regel jedes Speichern ab (RK §17, §22).
    function produktFelder() {
      return ['artNr', 'ausTeig', 'backTage', 'einheit', 'frosterZustaendigkeit', 'hinweis',
        'kategorie', 'legacyKey', 'manuelleErfassung', 'name', 'nfcSeite', 'pressenGroesse',
        'produktionsSchritt', 'schnellrechnerRelevant', 'station', 'stueckProBlech',
        'teiggewichtAufschlag', 'bedarfsQuelle', 'richtwert', 'pausiert',
        'werdegang',
        'reihenfolge', 'geloescht', 'sicherungId'];
    }
    function produktGesichert(id) {
      let sid = d().sicherungId;
      let s = getAfter(/databases/$(database)/documents/produkte_sicherungen/$(sid)).data;
      return sid is string && sid.size() > 0
        && (resource == null || resource.data.get('sicherungId', '') != sid)
        && !exists(/databases/$(database)/documents/produkte_sicherungen/$(sid))
        && existsAfter(/databases/$(database)/documents/produkte_sicherungen/$(sid))
        && s.collection == 'produkte'
        && ((s.aktion == 'einspielen' && s.dokId == '*')
          || (s.dokId == id
              && ((resource == null && s.vorher == null) || (resource != null && s.vorher == resource.data))));
    }
    match /produkte/{produktId} {
      allow read: if istAdmin() || hatKonto();
      allow create, update: if hatAdminRolle() && standSteigt()
        && d().keys().hasOnly(produktFelder()) && produktGesichert(produktId);
      allow delete: if false;
    }
    match /produkte_sicherungen/{id} {
      allow read: if hatAdminRolle();
      allow create: if hatAdminRolle()
        && d().keys().hasOnly(['collection', 'dokId', 'aktion', 'vorher', 'konto', 'ts'])
        && d().collection == 'produkte' && d().dokId is string
        && d().aktion in ['anlegen', 'aendern', 'archivieren', 'wiederherstellen', 'einspielen', 'export']
        && (d().vorher == null || d().vorher is map || d().vorher is list)
        && (d().aktion != 'export' || (d().dokId == '*' && d().vorher is map))
        && (d().aktion != 'einspielen' || (d().dokId == '*' && d().vorher is list))
        && d().konto == kennung() && d().ts == request.time;
      allow update, delete: if false;
    }
    match /produkte_stand/{id} {
      allow get: if istAdmin() || hatKonto();
      allow list, delete: if false;
      allow create: if id == 'aktuell' && hatAdminRolle()
        && d().keys().hasOnly(['nummer', 'geaendertAm', 'geaendertVon'])
        && d().nummer is int && d().nummer >= 1
        && d().geaendertAm == request.time
        && d().geaendertVon == kennung();
      allow update: if id == 'aktuell' && hatAdminRolle()
        && d().keys().hasOnly(['nummer', 'geaendertAm', 'geaendertVon'])
        && d().nummer is int
        && d().nummer > resource.data.nummer
        && d().geaendertAm == request.time
        && d().geaendertVon == kennung();
    }

    // WARNUNG: ein neues Einstellungsfeld braucht einen Eintrag in veBlock(), dieselben
    // Grenzen wie Editor und EINSTELLUNGEN_FELDER (bos_verbrauch_durchschnitt.js) (RK §24).
    function veZahl(b, f, lo, hi) { return b[f] is number && b[f] >= lo && b[f] <= hi; }
    function veGanz(b, f, lo, hi) { return b[f] is int && b[f] >= lo && b[f] <= hi; }
    function veBlock(b, mitErfassung) {
      return b is map
        && b.keys().hasOnly(['modus', 'stichprobeAnzahl', 'suchfensterWochen', 'kontiguierlichTage',
             'minStichprobe', 'schwelleProzent', 'schwelleAbsolut', 'ausgeschlosseneTage',
             'erfassungSchwelleBleche', 'erfassungSchwelleProzent'])
        && b.keys().hasAll(['modus', 'stichprobeAnzahl', 'suchfensterWochen', 'kontiguierlichTage',
             'minStichprobe', 'schwelleProzent', 'schwelleAbsolut', 'ausgeschlosseneTage'])
        && b.modus in ['stichprobe', 'kontiguierlich']
        && veGanz(b, 'stichprobeAnzahl', 1, 50) && veGanz(b, 'suchfensterWochen', 1, 52)
        && veGanz(b, 'kontiguierlichTage', 1, 365) && veGanz(b, 'minStichprobe', 1, 20)
        && veZahl(b, 'schwelleProzent', 0.01, 1) && veZahl(b, 'schwelleAbsolut', 0, 1000)
        && b.ausgeschlosseneTage is list && b.ausgeschlosseneTage.size() <= 400
        && ((mitErfassung && b.keys().hasAll(['erfassungSchwelleBleche', 'erfassungSchwelleProzent'])
              && veZahl(b, 'erfassungSchwelleBleche', 0, 100) && veZahl(b, 'erfassungSchwelleProzent', 0.01, 1))
          || (!mitErfassung && !b.keys().hasAny(['erfassungSchwelleBleche', 'erfassungSchwelleProzent'])));
    }
    function veGesichert() {
      let sid = d().sicherungId;
      let s = getAfter(/databases/$(database)/documents/verbrauch_einstellungen_sicherungen/$(sid)).data;
      return sid is string && sid.size() > 0
        && (resource == null || resource.data.get('sicherungId', '') != sid)
        && !exists(/databases/$(database)/documents/verbrauch_einstellungen_sicherungen/$(sid))
        && existsAfter(/databases/$(database)/documents/verbrauch_einstellungen_sicherungen/$(sid))
        && s.dokId == 'system'
        && ((resource == null && s.vorher == null && s.aktion == 'erstfuellung')
          || (resource != null && s.vorher == resource.data && s.aktion in ['aendern', 'zurueckholen']));
    }
    match /verbrauch_einstellungen/{id} {
      allow get: if istAdmin() || hatKonto();
      allow list, delete: if false;
      allow create, update: if id == 'system'
        && d().keys().hasOnly(['manuell', 'offiziell', 'stand', 'sicherungId', 'geaendertVon', 'geaendertAm'])
        && d().keys().hasAll(['manuell', 'offiziell', 'stand', 'sicherungId', 'geaendertVon', 'geaendertAm'])
        && veBlock(d().manuell, false) && veBlock(d().offiziell, true)
        && d().stand is int
        && ((resource == null && d().stand == 1) || (resource != null && d().stand == resource.data.stand + 1))
        && d().geaendertVon == kennung() && d().geaendertAm == request.time
        && hatAdminRolle() && veGesichert();
    }
    match /verbrauch_einstellungen_sicherungen/{id} {
      allow read: if hatAdminRolle();
      allow create: if d().keys().hasOnly(['dokId', 'aktion', 'vorher', 'konto', 'ts'])
        && d().dokId == 'system'
        && d().aktion in ['erstfuellung', 'aendern', 'zurueckholen']
        && (d().vorher == null || d().vorher is map)
        && d().konto == kennung() && d().ts == request.time
        && hatAdminRolle();
      allow update, delete: if false;
    }

    // WARNUNG: ein neues Feld braucht einen Eintrag in hasOnly.
    function teigeckeHaken(feld) {
      return hatKonto()
        && get(/databases/$(database)/documents/bos_accounts/$(kennung())).data
             .get(feld, false) == true;
    }
    function darfWagen() { return teigeckeHaken('teigeckePflege'); }
    function darfTeige() { return teigeckeHaken('teigeckeTeige'); }
    function darfRezepte() { return teigeckeHaken('teigeckeRezepte'); }
    function darfNacht() {
      return hatKonto() && !istAdmin()
        && rolle() in ['backstube', 'produktionsleitung', 'admin'];
    }
    function teigeckeHerkunft() {
      return d().geaendertVon == kennung()
        && d().geaendertAm == request.time
        && d().get('geloescht', false) is bool;
    }
    function teigeckeGesichert(col, docId) {
      let sid = d().sicherungId;
      let v = getAfter(/databases/$(database)/documents/teigecke_sicherungen/$(sid)).data.vorher;
      return sid is string && sid.size() > 0
        && (resource == null || resource.data.get('sicherungId', '') != sid)
        && !exists(/databases/$(database)/documents/teigecke_sicherungen/$(sid))
        && existsAfter(/databases/$(database)/documents/teigecke_sicherungen/$(sid))
        && getAfter(/databases/$(database)/documents/teigecke_sicherungen/$(sid)).data.collection == col
        && getAfter(/databases/$(database)/documents/teigecke_sicherungen/$(sid)).data.dokId == docId
        && ((resource == null && v == null) || (resource != null && v == resource.data));
    }
    function teigeckeZahl(f) {
      return d().get(f, 1) is number;
    }
    function teigeckeTag(id) {
      return id.matches('^20[0-9]{2}-[01][0-9]-[0-3][0-9]$');
    }

    match /teigecke_orte/{id} {
      allow read: if hatKonto();
      allow create, update: if d().keys().hasOnly(['kennung', 'name', 'art',
            'beschreibung', 'sort', 'bereich', 'bereichName', 'schildFolge',
            'geloescht', 'sicherungId', 'geaendertVon', 'geaendertAm'])
        && d().kennung is string
        && d().kennung.matches('^[A-Z][0-9]{2,3}$')
        && id == d().kennung.lower()
        && (resource == null || resource.data.kennung == d().kennung)
        && d().bereich == d().kennung[0:1]
        && d().bereichName is string
        && d().bereichName.size() <= 30
        && d().get('schildFolge', []) is list
        && d().get('schildFolge', []).size() <= 100
        && d().name is string
        && d().art in ['wagen', 'ort']
        && teigeckeZahl('sort')
        && darfWagen() && teigeckeHerkunft()
        && teigeckeGesichert('teigecke_orte', id);
      allow delete: if false;
    }
    match /teigecke_zutaten/{id} {
      allow read: if hatKonto();
      allow create, update: if d().keys().hasOnly(['name', 'ortId',
            'gebindeGroesse', 'gebindeEinheit', 'gruppe', 'geloescht', 'sicherungId', 'geaendertVon', 'geaendertAm'])
        && d().name is string
        && d().ortId is string
        && d().get('gruppe', '') is string
        && teigeckeZahl('gebindeGroesse')
        && d().get('gebindeEinheit', '') in ['', 'kg', 'l', 'stk']
        && darfWagen() && teigeckeHerkunft()
        && teigeckeGesichert('teigecke_zutaten', id);
      allow delete: if false;
    }
    match /bos_regelstand/{fassung} {
      allow get: if (hatKonto() || istAdmin()) && fassung in ['teigecke-2026-10-02', 'teigecke-orte-2026-10-03', 'nfc-qr-2026-10-04', 'produkte-2026-10-05', 'produkte-sicherung-2026-10-06', 'teigecke-rezepte-2026-10-07', 'teigecke-nacht-2026-10-08', 'reparatur-2026-10-10', 'richtwert-2026-10-14', 'teigrechner-2026-10-16', 'verbrauch-einstellungen-2026-10-20', 'nfc-qr-2026-10-21', 'backstore-2026-10-21', 'maschinen-2026-10-23', 'maschinen-b-2026-10-24', 'nachrichten-2026-10-27'];
      allow list, create, update, delete: if false;
    }
        match /teigecke_teige/{id} {
      allow read: if hatKonto();
      allow create, update: if id.matches('^[a-z0-9_]{2,40}$')
        && d().keys().hasOnly(['name', 'istSauerteig', 'mitSauer',
            'ohneSchuettwasser', 'hinweisOben', 'zutaten', 'vorstufe', 'vorstufeZutaten',
            'vorstufeHinweis', 'beiBedarf', 'sauerJeKg', 'hefeJeKg', 'vorstufeJeKg',
            'anstellgutAnteil', 'rezeptBasisKg', 'sort', 'geloescht', 'sicherungId',
            'geaendertVon', 'geaendertAm', 'vorstufeSchritt', 'vorstufeSchritteJeBehaelter',
            'vorstufeBehaelter', 'winbackFeld', 'winbackName', 'vorstufeWinbackFeld',
            'vorstufeWinbackName', 'langzeit'])
        && d().name is string
        && (!('mitSauer' in d()) || d().mitSauer is bool)
        && d().get('langzeit', false) is bool
        && d().get('vorstufeSchritt', []) is list
        && teigeckeZahl('vorstufeSchritteJeBehaelter')
        && d().zutaten is list
        && d().vorstufe is string
        && d().vorstufeZutaten is list
        && d().beiBedarf is list
        && teigeckeZahl('sauerJeKg') && teigeckeZahl('hefeJeKg') && teigeckeZahl('vorstufeJeKg')
        && teigeckeZahl('anstellgutAnteil') && teigeckeZahl('rezeptBasisKg')
        && (resource != null || !exists(/databases/$(database)/documents/teigrechner_teige/$(id)))
        && darfRezepte() && teigeckeHerkunft()
        && teigeckeGesichert('teigecke_teige', id);
      allow delete: if false;
    }
    match /teigecke_rezeptmengen/{id} {
      allow read: if darfRezepte();
      allow create, update: if id.matches('^[a-z0-9_]{2,40}$')
        && d().keys().hasOnly(['eingabe', 'sicherungId', 'geaendertVon', 'geaendertAm'])
        && d().eingabe is map
        && darfRezepte() && teigeckeHerkunft()
        && teigeckeGesichert('teigecke_rezeptmengen', id);
      allow delete: if false;
    }
    match /teigecke_teigwerte/{id} {
      allow read: if hatKonto();
      allow create, update: if id.matches('^[a-z0-9_]{2,40}$')
        && d().keys().hasOnly(['wasserLiterJeKg', 'wasserRefBrote',
            'wasserRefKg', 'wasserRefLiter', 'tabelle', 'einwaage', 'kesselMaxKg',
            'kesselrestKg', 'mehlKgJeKg', 'mehlRefBrote', 'mehlRefKg', 'mehlRefZugabeKg',
            'mehlZutatId', 'langzeitHefeSommerG', 'langzeitHefeSommerBeiKg',
            'langzeitHefeWinterG', 'langzeitHefeWinterBeiKg', 'sicherungId', 'geaendertVon', 'geaendertAm'])
        && d().get('tabelle', []) is list
        && d().get('einwaage', {}) is map
        && teigeckeZahl('wasserLiterJeKg') && teigeckeZahl('kesselMaxKg') && teigeckeZahl('kesselrestKg')
        && teigeckeZahl('mehlKgJeKg') && teigeckeZahl('mehlRefBrote') && teigeckeZahl('mehlRefKg')
        && teigeckeZahl('mehlRefZugabeKg') && d().get('mehlZutatId', '') is string
        && teigeckeZahl('langzeitHefeSommerG') && teigeckeZahl('langzeitHefeSommerBeiKg')
        && teigeckeZahl('langzeitHefeWinterG') && teigeckeZahl('langzeitHefeWinterBeiKg')
        && darfTeige() && teigeckeHerkunft()
        && teigeckeGesichert('teigecke_teigwerte', id);
      allow delete: if false;
    }
    match /teigecke_einstellungen/{id} {
      allow read: if hatKonto();
      allow create, update: if id == 'allgemein'
        && d().keys().hasOnly(['abwiegefolge', 'kesselMaxVorgabeKg',
            'sauerKesselMaxKg', 'sauerStufeKg', 'sauerHalbStufeKg', 'sauerSchwelleKg', 'jahreszeit',
            'sicherungId', 'geaendertVon', 'geaendertAm'])
        && d().get('abwiegefolge', {}) is map
        && d().get('jahreszeit', 'winter') in ['sommer', 'winter']
        && darfTeige() && teigeckeHerkunft()
        && teigeckeGesichert('teigecke_einstellungen', id);
      allow delete: if false;
    }
    match /teigecke_sicherungen/{id} {
      allow read: if darfRezepte()
        || (resource.data.collection != 'teigecke_rezeptmengen' && (darfWagen() || darfTeige()));
      allow create: if d().keys().hasOnly(['collection', 'dokId', 'aktion',
            'vorher', 'konto', 'ts'])
        && d().dokId is string
        && d().aktion in ['anlegen', 'aendern', 'archivieren', 'wiederherstellen']
        && (d().vorher == null || d().vorher is map)
        && d().ts == request.time
        && d().konto == kennung()
        && ((d().collection in ['teigecke_orte', 'teigecke_zutaten'] && darfWagen())
          || (d().collection in ['teigecke_teige', 'teigecke_rezeptmengen'] && darfRezepte())
          || (d().collection in ['teigecke_teigwerte', 'teigecke_einstellungen']
              && darfTeige()));
      allow update, delete: if false;
    }
    match /teigecke_naechte/{tag} {
      allow read: if hatKonto();
      allow create, update: if teigeckeTag(tag)
        && d().keys().hasOnly(['brote', 'kesselrest', 'temperatur',
            'prognose', 'sauerAnsatz', 'rezeptStand', 'vorrat', 'vorratHaken', 'vorstufeWahl', 'langzeit',
            'geaendertVon', 'geaendertAm'])
        && d().get('brote', {}) is map
        && d().get('vorrat', {}) is map
        && d().get('vorratHaken', {}) is map
        && d().get('vorstufeWahl', {}) is map
        && d().get('langzeit', {}) is map
        && d().get('kesselrest', {}) is map
        && d().get('prognose', {}) is map
        && d().geaendertVon == kennung()
        && d().geaendertAm == request.time
        && darfNacht();
      allow delete: if false;
    }
    match /teigecke_nacht_anpassungen/{id} {
      allow read: if hatKonto();
      allow create, update: if id == 'aktuell'
        && d().keys().hasOnly(['backtag', 'teige', 'geaendertVon', 'geaendertAm'])
        && teigeckeTag(d().backtag)
        && d().teige is map
        && d().geaendertVon == kennung()
        && d().geaendertAm == request.time
        && darfNacht();
      allow delete: if false;
    }
    // WARNUNG: ein neues Feld braucht einen Eintrag in hasOnly (RK §23).
    function darfWeitereTeige() { return teigeckeHaken('weitereTeige'); }
    function trGesichert(docId) {
      let sid = d().sicherungId;
      let v = getAfter(/databases/$(database)/documents/teigrechner_sicherungen/$(sid)).data;
      return sid is string && sid.size() > 0
        && (resource == null || resource.data.get('sicherungId', '') != sid)
        && !exists(/databases/$(database)/documents/teigrechner_sicherungen/$(sid))
        && existsAfter(/databases/$(database)/documents/teigrechner_sicherungen/$(sid))
        && v.collection == 'teigrechner_teige' && v.dokId == docId
        && ((resource == null && v.vorher == null) || (resource != null && v.vorher == resource.data));
    }
    match /teigrechner_teige/{id} {
      allow read: if hatKonto();
      allow create, update: if id.matches('^[a-z0-9_]{2,40}$')
        && d().keys().hasOnly(['name', 'stationen', 'hefeRefKg', 'hefeRefG', 'kesselMaxKg',
            'ausbeute', 'geloescht', 'sicherungId', 'geaendertVon', 'geaendertAm'])
        && d().name is string && d().name.size() >= 1 && d().name.size() <= 60
        && d().stationen is list
        && d().stationen.hasOnly(['Brötchenstraße', 'Frühschicht', 'Rondo', 'Konditorei', 'Versand'])
        && d().get('ausbeute', {}) is map
        && teigeckeZahl('hefeRefKg') && teigeckeZahl('hefeRefG') && teigeckeZahl('kesselMaxKg')
        && (resource != null || !exists(/databases/$(database)/documents/teigecke_teige/$(id)))
        && darfWeitereTeige() && teigeckeHerkunft() && trGesichert(id);
      allow delete: if false;
    }
    match /teigrechner_sicherungen/{id} {
      allow read: if darfWeitereTeige();
      allow create: if d().keys().hasOnly(['collection', 'dokId', 'aktion', 'vorher', 'konto', 'ts'])
        && d().collection == 'teigrechner_teige' && d().dokId is string
        && d().aktion in ['anlegen', 'aendern', 'archivieren', 'wiederherstellen']
        && (d().vorher == null || d().vorher is map)
        && d().ts == request.time && d().konto == kennung()
        && darfWeitereTeige();
      allow update, delete: if false;
    }
    match /nfc_sammelblaetter/{id} {
      allow read: if istAdmin();
      allow create, update: if istAdmin()
        && d().keys().hasOnly(['standort', 'ausstattung', 'zeilen',
            'geloescht', 'geaendertVon', 'geaendertAm'])
        && d().standort is string
        && d().standort.size() >= 1
        && d().standort.size() <= 40
        && d().ausstattung in ['qr', 'chip', 'beides']
        && d().zeilen is list
        && d().zeilen.size() <= 9
        && d().geloescht is bool
        && d().geaendertVon == kennung()
        && d().geaendertAm == request.time;
      allow delete: if false;
    }

    // RK §25 · Zugangsblatt-Auswahl der Zentrale: nur Generalschlüssel, nur ids (je Platz geprüft).
    function zbId(l, i) {
      return l.size() <= i || (l[i] is string && l[i].matches('^[a-z0-9_]{1,40}$'));
    }
    match /nfc_einstellungen/{id} {
      allow read: if istAdmin();
      allow create, update: if istAdmin() && id == 'zugangsblatt'
        && d().keys().hasOnly(['ziele', 'geaendertVon', 'geaendertAm'])
        && d().ziele is list && d().ziele.size() <= 6
        && zbId(d().ziele, 0) && zbId(d().ziele, 1) && zbId(d().ziele, 2)
        && zbId(d().ziele, 3) && zbId(d().ziele, 4) && zbId(d().ziele, 5)
        && d().geaendertVon == kennung()
        && d().geaendertAm == request.time;
      allow delete: if false;
    }

    // RK §26 · BackStore-Texte: lesen alle mit Konto, schreiben Rolle admin, je App ein Dokument, Sicherung im selben Batch.
    // WARNUNG: dieselben Grenzen stehen in bos_backstore_texte.js (GRENZEN, FELDER) — immer beide.
    function btGesichert(id) {
      let sid = d().sicherungId;
      let s = getAfter(/databases/$(database)/documents/backstore_texte_sicherungen/$(sid)).data;
      return sid is string && sid.size() > 0
        && (resource == null || resource.data.get('sicherungId', '') != sid)
        && !exists(/databases/$(database)/documents/backstore_texte_sicherungen/$(sid))
        && existsAfter(/databases/$(database)/documents/backstore_texte_sicherungen/$(sid))
        && s.appId == id
        && ((resource == null && s.vorher == null && s.aktion in ['erstfuellung', 'anlegen'])
          || (resource != null && s.vorher == resource.data && s.aktion in ['aendern', 'zurueckholen']));
    }
    match /backstore_texte/{id} {
      allow read: if istAdmin() || hatKonto();
      allow create, update: if id.matches('^[a-z0-9_]{1,40}$')
        && d().keys().hasOnly(['kurz', 'lang', 'verlauf', 'wieBei', 'sicherungId', 'geaendertVon', 'geaendertAm'])
        && d().keys().hasAll(['kurz', 'lang', 'verlauf', 'sicherungId', 'geaendertVon', 'geaendertAm'])
        && d().kurz is map && d().kurz.keys().hasOnly(['de']) && d().kurz.de is string && d().kurz.de.size() <= 160
        && d().lang is map && d().lang.keys().hasOnly(['de']) && d().lang.de is string && d().lang.de.size() <= 1200
        && d().verlauf is list && d().verlauf.size() <= 100
        && (!d().keys().hasAny(['wieBei'])
          || (d().wieBei is string && d().wieBei.matches('^[a-z0-9_]{1,40}$') && d().wieBei != id
            && d().lang.de == '' && d().verlauf.size() == 0))
        && d().geaendertVon == kennung() && d().geaendertAm == request.time
        && hatAdminRolle() && btGesichert(id);
      allow delete: if false;
    }
    match /backstore_texte_sicherungen/{id} {
      allow read: if hatAdminRolle();
      allow create: if d().keys().hasOnly(['appId', 'aktion', 'vorher', 'konto', 'ts'])
        && d().appId is string && d().appId.matches('^[a-z0-9_]{1,40}$')
        && d().aktion in ['erstfuellung', 'anlegen', 'aendern', 'zurueckholen']
        && (d().vorher == null || d().vorher is map)
        && d().konto == kennung() && d().ts == request.time
        && hatAdminRolle();
      allow update, delete: if false;
    }

    // RK §27 · ERSATZFORM (ohne ?:, liste[i:j], Karten-Literal) · Maschinen: lesen Personenkonten (art person) und Admin, Stammdaten Rolle admin,
    // Angaben + Backreihenfolge nur eingetragene Maschinenführer, nie löschen.
    function personKonto() {
      return hatKonto()
        && get(/databases/$(database)/documents/bos_accounts/$(kennung())).data
             .get('art', '') == 'person';
    }
    function msLesen() { return istAdmin() || hatAdminRolle() || personKonto(); }
    function msMaschine(m) { return get(/databases/$(database)/documents/maschinen/$(m)).data; }
    function msFuehrer(m) {
      return personKonto() && msMaschine(m).get('geloescht', false) != true
        && kennung() in msMaschine(m).fuehrer;
    }
    function msHerkunft() {
      return d().geaendertVon == kennung() && d().geaendertAm == request.time
        && d().geaendertVonName is string && d().geaendertVonName.size() <= 40;
    }
    function msEintrag0(e, alt) {
      return e.keys().hasOnly(['werte', 'von', 'vonName', 'am']) && e.keys().hasAll(['werte', 'von', 'vonName', 'am'])
        && e.werte == alt.werte && e.von == alt.geaendertVon
        && e.vonName == alt.geaendertVonName && e.am == alt.geaendertAm;
    }
    function msFolgt(f, alt) {
      let n = alt.frueher.size();
      return ((n < 20 && f.size() == n + 1) || (n >= 20 && f.size() == 20))
        && msEintrag0(f[0], alt)
        && (f.size() < 2 || f[1] == alt.frueher[0])
        && (f.size() < 3 || f[2] == alt.frueher[1])
        && (f.size() < 4 || f[3] == alt.frueher[2])
        && (f.size() < 5 || f[4] == alt.frueher[3])
        && (f.size() < 6 || f[5] == alt.frueher[4])
        && (f.size() < 7 || f[6] == alt.frueher[5])
        && (f.size() < 8 || f[7] == alt.frueher[6])
        && (f.size() < 9 || f[8] == alt.frueher[7])
        && (f.size() < 10 || f[9] == alt.frueher[8])
        && (f.size() < 11 || f[10] == alt.frueher[9])
        && (f.size() < 12 || f[11] == alt.frueher[10])
        && (f.size() < 13 || f[12] == alt.frueher[11])
        && (f.size() < 14 || f[13] == alt.frueher[12])
        && (f.size() < 15 || f[14] == alt.frueher[13])
        && (f.size() < 16 || f[15] == alt.frueher[14])
        && (f.size() < 17 || f[16] == alt.frueher[15])
        && (f.size() < 18 || f[17] == alt.frueher[16])
        && (f.size() < 19 || f[18] == alt.frueher[17])
        && (f.size() < 20 || f[19] == alt.frueher[18]);
    }
    match /maschinen/{m} {
      allow read: if msLesen();
      allow create, update: if m.matches('^[a-z0-9]{2,30}$')
        && d().keys().hasOnly(['name', 'exemplare', 'fuehrer', 'felder', 'geloescht', 'geaendertVon', 'geaendertAm'])
        && d().keys().hasAll(['name', 'exemplare', 'fuehrer', 'felder', 'geaendertVon', 'geaendertAm'])
        && d().name is string && d().name.size() >= 1 && d().name.size() <= 40
        && d().exemplare is map && d().exemplare.size() >= 1 && d().exemplare.size() <= 12
        && d().fuehrer is list && d().fuehrer.size() <= 20
        && d().felder is list && d().felder.size() <= 12
        && d().get('geloescht', false) is bool
        && d().geaendertVon == kennung() && d().geaendertAm == request.time
        && hatAdminRolle();
      allow delete: if false;
    }
    match /maschinen_reihenfolge/{m} {
      allow read: if msLesen();
      allow create, update: if d().keys().hasOnly(['produkte', 'geaendertVon', 'geaendertVonName', 'geaendertAm'])
        && d().keys().hasAll(['produkte', 'geaendertVon', 'geaendertVonName', 'geaendertAm'])
        && d().produkte is list && d().produkte.size() <= 300
        && msHerkunft() && msFuehrer(m);
      allow delete: if false;
    }
    match /maschinen_angaben/{id} {
      allow read: if msLesen();
      allow create, update: if d().keys().hasOnly(['maschine', 'produkt', 'werte', 'frueher', 'geaendertVon', 'geaendertVonName', 'geaendertAm'])
        && d().keys().hasAll(['maschine', 'produkt', 'werte', 'frueher', 'geaendertVon', 'geaendertVonName', 'geaendertAm'])
        && d().maschine is string && d().maschine.matches('^[a-z0-9]{2,30}$')
        && d().produkt is string && id == d().maschine + '__' + d().produkt
        && d().werte is map && d().werte.size() <= 12
        && d().frueher is list
        && ((resource == null && d().frueher.size() == 0)
          || (resource != null && msFolgt(d().frueher, resource.data)))
        && msHerkunft() && msFuehrer(d().maschine);
      allow delete: if false;
    }

    // RK §28 · Maschinenseite Stufe B: Chatfenster (maschinen_notizen, TTL-Feld fristStart, 40 Tage als Versatz der TTL-Richtlinie)
    // und Info-Karten (maschinen_karten). Ohne ?:, liste[i:j], Karten-Literal, diff() (B15). Unverändert = Feld für Feld gleich.
    function msExemplar(m, e) {
      return e == 'alle' || msMaschine(m).exemplare.keys().hasAll([e]);
    }
    function mnFest(a, b) {
      return a.maschine == b.maschine && a.exemplar == b.exemplar && a.text == b.text
        && a.von == b.von && a.vonName == b.vonName && a.erstellt == b.erstellt;
    }
    function mnAngepinnt() {
      return !d().keys().hasAny(['fristStart'])
        && d().angepinntVon == kennung()
        && d().angepinntVonName is string && d().angepinntVonName.size() <= 40;
    }
    function mnFrist(start) {
      return d().fristStart == start && !d().keys().hasAny(['angepinntVon', 'angepinntVonName']);
    }
    match /maschinen_notizen/{id} {
      allow read: if msLesen();
      allow create: if personKonto()
        && d().keys().hasOnly(['maschine', 'exemplar', 'text', 'von', 'vonName', 'erstellt', 'fristStart', 'angepinntVon', 'angepinntVonName'])
        && d().keys().hasAll(['maschine', 'exemplar', 'text', 'von', 'vonName', 'erstellt'])
        && d().maschine is string && d().maschine.matches('^[a-z0-9]{2,30}$')
        && msMaschine(d().maschine).get('geloescht', false) != true
        && d().exemplar is string && msExemplar(d().maschine, d().exemplar)
        && d().text is string && d().text.size() >= 1 && d().text.size() <= 500
        && d().von == kennung() && d().vonName is string && d().vonName.size() <= 40
        && d().erstellt == request.time
        && (mnFrist(request.time) || mnAngepinnt());
      allow update: if personKonto()
        && d().keys().hasOnly(['maschine', 'exemplar', 'text', 'von', 'vonName', 'erstellt', 'fristStart', 'angepinntVon', 'angepinntVonName'])
        && mnFest(d(), resource.data)
        && (mnFrist(resource.data.erstellt) || mnAngepinnt());
      allow delete: if (personKonto() && resource.data.von == kennung()) || istAdmin() || hatAdminRolle();
    }
    match /maschinen_karten/{id} {
      allow read: if msLesen();
      allow create, update: if d().keys().hasOnly(['maschine', 'exemplar', 'titel', 'text', 'rang', 'stand', 'geaendertVon', 'geaendertVonName', 'geaendertAm'])
        && d().keys().hasAll(['maschine', 'exemplar', 'titel', 'text', 'rang', 'stand', 'geaendertVon', 'geaendertVonName', 'geaendertAm'])
        && d().maschine is string && d().maschine.matches('^[a-z0-9]{2,30}$')
        && (resource == null || resource.data.maschine == d().maschine)
        && d().exemplar is string && msExemplar(d().maschine, d().exemplar)
        && d().titel is string && d().titel.size() >= 1 && d().titel.size() <= 60
        && d().text is string && d().text.size() <= 2000
        && d().rang is int && d().rang >= 0 && d().rang <= 99
        && d().stand is int
        && ((resource == null && d().stand == 1) || (resource != null && d().stand == resource.data.stand + 1))
        && msHerkunft() && msFuehrer(d().maschine);
      allow delete: if msFuehrer(resource.data.maschine);
    }

    // WARNUNG: ein neues Feld braucht einen Eintrag in hasOnly (RK §20).
    function reparaturHaken(feld) {
      return hatKonto()
        && get(/databases/$(database)/documents/bos_accounts/$(kennung())).data
             .get(feld, false) == true;
    }
    function darfMelden() { return reparaturHaken('reparaturMelden'); }
    function darfBearbeiten() { return reparaturHaken('reparaturBearbeiten'); }
    function darfMitlesen() {
      return reparaturHaken('reparaturLesen') || darfMelden() || darfBearbeiten();
    }
    function meldung(id) { return /databases/$(database)/documents/meldungen/$(id); }
    function eintrag(id, e) { return /databases/$(database)/documents/meldungen/$(id)/verlauf/$(e); }
    function imArchiv(k) {
      return k.status == 'repariert' && request.time >= k.repariertAm + duration.value(7, 'd');
    }
    function statusSchritt(a, n) {
      return (a == n && d().repariertAm == resource.data.repariertAm)
        || (a == 'gemeldet' && n == 'gesehen' && d().repariertAm == null)
        || (a in ['gemeldet', 'gesehen'] && n == 'repariert' && d().repariertAm == request.time)
        || (a == 'repariert' && n == 'gesehen' && d().repariertAm == null);
    }
    match /meldungen/{id} {
      allow get, list: if darfMitlesen() && resource.data.kanal == 'hausmeister';
      allow create: if darfMelden()
        && d().keys().hasOnly(['kanal', 'text', 'geraet', 'weiterarbeiten', 'von', 'vonName',
            'erstellt', 'status', 'dringlichkeit', 'fenster', 'repariertAm',
            'geaendertVon', 'geaendertAm', 'letzterEintrag'])
        && d().kanal == 'hausmeister'
        && d().text is string && d().text.size() >= 1 && d().text.size() <= 500
        && d().geraet is string && d().geraet.size() <= 60
        && d().weiterarbeiten in ['ja', 'eingeschraenkt', 'nein']
        && d().von == kennung() && d().vonName is string && d().vonName.size() <= 40
        && d().erstellt == request.time
        && d().status == 'gemeldet' && d().dringlichkeit == 'normal'
        && d().fenster == '' && d().repariertAm == null && d().letzterEintrag == ''
        && d().geaendertVon == kennung() && d().geaendertAm == request.time;
      allow update: if darfBearbeiten() && !imArchiv(resource.data)
        && d().geaendertVon == kennung() && d().geaendertAm == request.time
        && d().letzterEintrag is string && d().letzterEintrag.size() > 0
        && !exists(eintrag(id, d().letzterEintrag))
        && existsAfter(eintrag(id, d().letzterEintrag))
        && d().diff(resource.data).affectedKeys().hasOnly([
             getAfter(eintrag(id, d().letzterEintrag)).data.art,
             'repariertAm', 'geaendertVon', 'geaendertAm', 'letzterEintrag'])
        && d().dringlichkeit in ['normal', 'dringend']
        && (d().fenster == '' || d().fenster.matches('^20[0-9]{2}-[01][0-9]-[0-3][0-9]$'))
        && statusSchritt(resource.data.status, d().status);
      allow delete: if false;

      match /verlauf/{e} {
        allow read: if darfMitlesen() && get(meldung(id)).data.kanal == 'hausmeister';
        allow create: if d().von == kennung() && d().ts == request.time
          && d().vonName is string && d().vonName.size() <= 40
          && !imArchiv(get(meldung(id)).data)
          && ((d().art == 'nachricht' && darfMitlesen()
               && d().keys().hasOnly(['art', 'von', 'vonName', 'ts', 'text'])
               && d().text is string && d().text.size() >= 1 && d().text.size() <= 300)
            || (d().art in ['status', 'fenster', 'dringlichkeit'] && darfBearbeiten()
               && d().keys().hasOnly(['art', 'von', 'vonName', 'ts', 'vorher', 'nachher', 'grund'])
               && d().grund is string && d().grund.size() <= 300
               && d().vorher == get(meldung(id)).data[d().art]
               && d().nachher == getAfter(meldung(id)).data[d().art]
               && d().nachher != d().vorher
               && getAfter(meldung(id)).data.letzterEintrag == e));
        allow update, delete: if false;
      }
    }
    // RK §29 · Nachrichtenzentrale Stufe 1b: Adressbuch (Schild, nur Anzeige), Vorlagen, privater Lesestatus, Nachrichten
    // mit Antworten. Das Schloss sind die Haken im Konto (nzHaken). Kritik ohne Bekanntmachungs-Haken nur an die Leitungsliste;
    // Korrektur = neue Nachricht + Sperre der alten im selben Batch (getAfter); Bekanntmachung ohne Empfängerliste, ohne
    // Daumen, ohne fristStart bis zum Lösen; Antworten unter vier Augen (Feld an). Ohne ?:, liste[i:j], Karten-Literal (RK §29).
    function nzKonto() { return get(/databases/$(database)/documents/bos_accounts/$(kennung())).data; }
    function nzHaken(feld) { return hatKonto() && nzKonto().get(feld, false) == true; }
    function nzEmpfaenger() {
      return hatKonto()
        && (nzKonto().get('art', '') == 'person' || nzKonto().get('nachrichtenEmpfangen', false) == true);
    }
    function nz(id) { return /databases/$(database)/documents/nachrichten/$(id); }
    function nzKopf(id) { return get(nz(id)).data; }
    function nzGesperrt(k) { return k.keys().hasAny(['ersetztDurch']); }
    function nzLeser(k) {
      return k.von == kennung() || k.typ == 'bekanntmachung' || kennung() in k.get('empfaenger', []);
    }
    function nzName(n) { return n is string && n.size() <= 40; }
    function nzLeitung() { return get(/databases/$(database)/documents/nachrichten_vorlagen/leitung).data.kennungen; }
    function nzKopfGleich() {
      return d().von == kennung() && nzName(d().vonName)
        && d().text is string && d().text.size() >= 1 && d().text.size() <= 2000
        && d().erstellt == request.time;
    }
    function nzNormal() {
      return d().typ in ['nachricht', 'info', 'lob', 'kritik']
        && d().keys().hasOnly(['von', 'vonName', 'typ', 'empfaenger', 'text', 'erstellt', 'fristStart', 'daumen', 'ersetzt'])
        && d().keys().hasAll(['von', 'vonName', 'typ', 'empfaenger', 'text', 'erstellt', 'fristStart', 'daumen'])
        && d().empfaenger is list && d().empfaenger.size() >= 1 && d().empfaenger.size() <= 100
        && d().fristStart == request.time
        && d().daumen is list && d().daumen.size() == 0
        && (d().typ != 'kritik' || nzHaken('nachrichtenBekanntmachung') || nzLeitung().hasAll(d().empfaenger));
    }
    function nzBekanntmachung() {
      return d().typ == 'bekanntmachung' && nzHaken('nachrichtenBekanntmachung')
        && d().keys().hasOnly(['von', 'vonName', 'typ', 'text', 'erstellt', 'giltBis', 'ersetzt'])
        && d().keys().hasAll(['von', 'vonName', 'typ', 'text', 'erstellt', 'giltBis'])
        && d().giltBis is string && d().giltBis.matches('^20[0-9]{2}-[01][0-9]-[0-3][0-9]$');
    }
    function nzKorrektur(neuId) {
      return !d().keys().hasAny(['ersetzt'])
        || (d().ersetzt is string
            && nzKopf(d().ersetzt).von == kennung()
            && !nzGesperrt(nzKopf(d().ersetzt))
            && nzKopf(d().ersetzt).typ == d().typ
            && getAfter(nz(d().ersetzt)).data.ersetztDurch == neuId);
    }
    function nzDaumenDazu(alt, neu) {
      return neu.size() == alt.size() + 1 && neu.hasAll(alt)
        && neu.hasAll([kennung()]) && !alt.hasAll([kennung()]);
    }
    function nzDaumenWeg(alt, neu) {
      return neu.size() == alt.size() - 1 && alt.hasAll(neu)
        && alt.hasAll([kennung()]) && !neu.hasAll([kennung()]);
    }
    match /nachrichten_adressbuch/{k} {
      allow read: if istAdmin() || hatKonto();
      allow create, delete: if istAdmin();
      allow update: if istAdmin()
        || (hatKonto() && k == kennung()
            && d().diff(resource.data).affectedKeys().hasOnly(['beschreibung'])
            && d().beschreibung is string && d().beschreibung.size() <= 40);
    }
    match /nachrichten_vorlagen/{id} {
      allow read: if istAdmin() || hatKonto();
      allow create, update, delete: if istAdmin();
    }
    match /nachrichten_status/{k} {
      allow read, delete: if istAdmin() || (hatKonto() && k == kennung());
      allow create, update: if hatKonto() && k == kennung()
        && d().keys().hasOnly(['gelesen', 'ausgeblendet']) && d().keys().hasAll(['gelesen', 'ausgeblendet'])
        && d().gelesen is map && d().ausgeblendet is map;
    }
    match /nachrichten/{id} {
      allow read: if istAdmin() || (hatKonto() && nzLeser(resource.data));
      allow create: if nzHaken('nachrichtenSchreiben') && nzKopfGleich()
        && (nzNormal() || nzBekanntmachung())
        && nzKorrektur(id);
      allow update: if hatKonto() && (
        (nzEmpfaenger() && kennung() in resource.data.get('empfaenger', [])
          && resource.data.typ != 'bekanntmachung' && !nzGesperrt(resource.data)
          && d().diff(resource.data).affectedKeys().hasOnly(['daumen']) && d().daumen is list
          && (nzDaumenDazu(resource.data.daumen, d().daumen) || nzDaumenWeg(resource.data.daumen, d().daumen)))
        || (resource.data.von == kennung() && !nzGesperrt(resource.data)
          && d().diff(resource.data).affectedKeys().hasOnly(['ersetztDurch']) && d().ersetztDurch is string
          && getAfter(nz(d().ersetztDurch)).data.ersetzt == id
          && getAfter(nz(d().ersetztDurch)).data.von == kennung())
        || (resource.data.typ == 'bekanntmachung' && !resource.data.keys().hasAny(['fristStart'])
          && d().diff(resource.data).affectedKeys().hasOnly(['fristStart']) && d().fristStart == request.time
          && (resource.data.von == kennung() || istPlanung())));
      allow delete: if false;

      match /antworten/{a} {
        allow read: if istAdmin() || (hatKonto()
          && (nzKopf(id).von == kennung() || resource.data.von == kennung() || resource.data.an == kennung()));
        allow create: if nzEmpfaenger() && nzLeser(nzKopf(id))
          && !nzGesperrt(nzKopf(id)) && nzKopf(id).typ != 'bekanntmachung'
          && d().keys().hasOnly(['von', 'vonName', 'an', 'text', 'ts', 'fristStart'])
          && d().keys().hasAll(['von', 'vonName', 'an', 'text', 'ts', 'fristStart'])
          && d().von == kennung() && nzName(d().vonName)
          && d().an is string && d().an != kennung()
          && ((d().von == nzKopf(id).von && d().an in nzKopf(id).empfaenger)
              || (d().von != nzKopf(id).von && d().an == nzKopf(id).von))
          && d().text is string && d().text.size() >= 1 && d().text.size() <= 1000
          && d().ts == request.time && d().fristStart == request.time;
        allow update, delete: if false;
      }
    }
  }
}